      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>
CALCULATE;

-- Ticket Promedio por Factura/Transacción
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
AS [Measures].[Monto Total] / [Measures].[Recuento FACT VENTAS BIKEZ],
FORMAT_STRING = "Currency",
VISIBLE = 1,
DISPLAY_FOLDER = 'KPIs Negocio';

-- Precio Promedio Ponderado por Unidad Vendida
CREATE MEMBER CURRENTCUBE.[Measures].[Precio Promedio Unidad]
AS [Measures].[Monto Total] / [Measures].[Cantidad],
FORMAT_STRING = "Currency",
VISIBLE = 1,
DISPLAY_FOLDER = 'KPIs Negocio';


-- Ventas del Periodo Anterior (Mes previo)
CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Periodo Anterior]
AS (
ParallelPeriod(
[DIM FECHA].[Nom Mes].[Nom Mes],
1,
[DIM FECHA].[Nom Mes].CurrentMember
),
[Measures].[Monto Total]
),
FORMAT_STRING = "Currency",
VISIBLE = 1,
DISPLAY_FOLDER = 'Aceleracion Productos';

-- Tasa de Crecimiento de Ventas
CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Crecimiento Ventas]
AS IIF(
IsEmpty([Measures].[Ventas Periodo Anterior]) OR [Measures].[Ventas Periodo Anterior] = 0,
NULL,
([Measures].[Monto Total] - [Measures].[Ventas Periodo Anterior]) / [Measures].[Ventas Periodo Anterior]
),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Aceleracion Productos';

-- Vendedores Únicos con Ventas
CREATE MEMBER CURRENTCUBE.[Measures].[Vendedores Activos]
AS DistinctCount(
Filter(
[DIM EMPLEADO].[Sk Empleado].[Sk Empleado].Members,
[Measures].[Recuento FACT VENTAS BIKEZ] &gt; 0
)
),
FORMAT_STRING = "#,##0",
VISIBLE = 1,
DISPLAY_FOLDER = 'Fuerza de Ventas';

-- Productividad Media por Vendedor
CREATE MEMBER CURRENTCUBE.[Measures].[Productividad Media Vendedor]
AS IIF(
[Measures].[Vendedores Activos] = 0,
0,
[Measures].[Monto Total] / [Measures].[Vendedores Activos]
),
FORMAT_STRING = "Currency",
VISIBLE = 1,
DISPLAY_FOLDER = 'Fuerza de Ventas';

-- Total de Clientes con compras registradas
CREATE MEMBER CURRENTCUBE.[Measures].[Total Clientes Compradores]
AS DistinctCount(
Filter(
[DIM CLIENTE].[Sk Cliente].[Sk Cliente].Members,
[Measures].[Recuento FACT VENTAS BIKEZ] &gt; 0
)
),
FORMAT_STRING = "#,##0",
VISIBLE = 1,
DISPLAY_FOLDER = 'Clientes y Fidelizacion';

-- Clientes Recurrentes (2 o más registros de venta distintos)
CREATE MEMBER CURRENTCUBE.[Measures].[Clientes Recurrentes]
AS Count(
Filter(
[DIM CLIENTE].[Sk Cliente].[Sk Cliente].Members,
[Measures].[Recuento FACT VENTAS BIKEZ] &gt;= 2
)
),
FORMAT_STRING = "#,##0",
VISIBLE = 1,
DISPLAY_FOLDER = 'Clientes y Fidelizacion';

-- Tasa de Fidelización / Recurrencia
CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Recurrencia]
AS IIF(
[Measures].[Total Clientes Compradores] = 0,
0,
[Measures].[Clientes Recurrentes] / [Measures].[Total Clientes Compradores]
),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Clientes y Fidelizacion'; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
